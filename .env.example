# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (Default: 3000)
PORT=3000

# DOMAIN: Internal or public domain (e.g., misa.tencongty.vn)
DOMAIN=misa.tencongty.vn

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_32chars_min
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# Cache TTL (seconds) for MISA queries
CACHE_TTL=60

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# MISA SME Database connection (Read-Only)
# These can also be configured via /config/misa.config.json or Web Admin UI
MISA_SERVER=localhost
MISA_DATABASE=MISA_SME_2022_DEMO
MISA_PORT=1433
MISA_USER=sa
MISA_PASSWORD=YourStrongPasswordHere
MISA_TIMEOUT=15000
MISA_ENCRYPT=false

